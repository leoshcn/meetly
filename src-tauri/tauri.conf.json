{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meetly",
  "version": "0.3.0",
  "identifier": "com.meetly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meetly",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFRTdERjlDMTZCRDZCODUKUldTRmE3MFduTi9uL3JoN0VDY2ZwOVk3OHViMGhHN0RxdGRyWU9zaHN4Z3J2eUhlMDg5aWxLYXYK",
      "endpoints": [
        "https://github.com/leoshcn/meetly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
